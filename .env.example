# Kombi Klima GO — ortam değişkenleri (.env.local olarak kopyalayın; sunucuda .env)
SITE_URL=https://kombiklimago.com

# ORTAK VERİTABANI: gazamuhendislik.com.tr sitesinin .env dosyasındaki değerlerin AYNISI
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Admin oturum anahtarı (rastgele uzun bir metin; bu siteye özel olabilir)
ADMIN_SESSION_SECRET=

# Görseller: iki site aynı sunucudaysa gazamuhendislik'in UPLOAD_DIR yolunu aynen verin (önerilen).
UPLOAD_DIR=/home/CPANEL_KULLANICI/gaza-uploads
# Görsel bu sunucuda bulunamazsa buradan çekilir
UPLOAD_FALLBACK_URL=https://gazamuhendislik.com.tr

# E-posta: destek@, siparis@, noreply@kombiklimago.com (adresler src/lib/site.ts içinde; burada yalnızca parolalar)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SIPARIS_PASS=
NOREPLY_PASS=
MAIL_TO=
ORDER_MAIL_TO=

# WhatsApp bildirimleri (CallMeBot) ve mobil bildirimler (Expo) — isteğe bağlı
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=
EXPO_ACCESS_TOKEN=
